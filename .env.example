# Frontend (Vite)
# Leave VITE_API_BASE_URL empty on Vercel when the Node API is deployed in the same project.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=your_public_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Node API
NODE_ENV=production
AI_SERVICE_URL=https://your-ai-service.example.com
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
RATE_LIMIT_PER_MINUTE=60
AI_SERVICE_TIMEOUT_MS=30000

# Firebase Admin (choose one approach)
# Preferred on Vercel: paste the full JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Alternative split variables:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Python AI service
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_TIMEOUT_SECONDS=30
